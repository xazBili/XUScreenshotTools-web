/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer

/index.html
  Cache-Control: no-cache

/icon.png
  Cache-Control: public, max-age=86400

/favicon.ico
  Cache-Control: public, max-age=86400

/XUScreenshotTools-*
  Content-Type: application/octet-stream
  Cache-Control: public, max-age=0, must-revalidate
